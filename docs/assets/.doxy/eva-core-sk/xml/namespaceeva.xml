</parameternamelist>
<parameterdescription>
<para>Pin mode (usually INPUT) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>LEVELS</parametername>
</parameternamelist>
<parameterdescription>
<para>Threshold values for each button (expected ADC readings)</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="see"><para>PinMultiSwitch For use cases without click detection </para>
</simplesect>
</para>
